{
  "name": "ten-second-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "10-SECOND CHALLENGE: a fast-paced arcade party game of 10-second mini-games.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
